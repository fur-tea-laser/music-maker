{
  "nodeModulesDir": "auto",
  "tasks": {
    "buildClient": "deno run -A scripts/buildClient.ts",
    "serveClient": "deno run -A https://deno.land/std@0.224.0/http/file_server.ts dist --port 8000"
  },
  "imports": {
    "esbuild": "npm:esbuild@^0.27.3",
    "esbuild-wasm": "npm:esbuild-wasm@0.24.2",
    "esbuild-sass-plugin": "npm:esbuild-sass-plugin@^3.6.0",
    "preact": "npm:preact@^10.28.4",
    "preact-iso": "npm:preact-iso@^2.11.1",
    "preact-render-to-string": "npm:preact-render-to-string@^6.5.13",
    "fflate": "npm:fflate@^0.8.2"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "npm:preact"
  }
}